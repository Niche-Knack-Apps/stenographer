# Maintainer: Niche-Knack Apps <support@niche-knack.com>
pkgname=stenographer
pkgver=0.5.0
pkgrel=1
pkgdesc="Shell history daemon"
arch=('x86_64')
url="https://github.com/Niche-Knack-Apps/stenographer"
license=('Apache-2.0')
depends=('gcc-libs' 'sqlite')
makedepends=(
    'rust'
    'cargo'
    'pkg-config'
)
provides=('stenographer')
conflicts=('stenographer-bin' 'stenographer-git')
source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/Niche-Knack-Apps/stenographer/archive/v$pkgver.tar.gz"
)
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Install binaries
    install -Dm755 "target/release/stenographerd" "$pkgdir/usr/bin/stenographerd"
    install -Dm755 "target/release/steno" "$pkgdir/usr/bin/steno"

    # Install license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
